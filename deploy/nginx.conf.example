# sandbox.yoshina.moe（デザイン試作サイト）を nginx から直接配信する例。
#
# yoshina.moe 系のサイト（yoshinamoego）と同じサーバーで動くが、こちらは静的ファイルだけ。
# アプリのプロセスは持たず、nginx がドキュメントルートのファイルをそのまま返す。
#
# 配置（公開するのは次の 5 つだけ。deploy/ や .git は置かない）:
#
#   sudo install -d -m 0755 /var/www/sandbox.yoshina.moe
#   sudo rsync -a --delete index.html about.html examples designsheets assets /var/www/sandbox.yoshina.moe/
#
# URL は拡張子なし。/about → about.html を返す。.html 付きで来たら拡張子なしへ 301 で寄せる。
# example は /no.<N> で見せる。/no.1 → examples/1/index.html、/no.1/main.js → examples/1/main.js、
# /no.1/foo → examples/1/foo.html。旧 URL（/examples/1 など）は /no.1 へ 301 で寄せる。
# designsheet は /designsheets/<N> で見せる（ディレクトリと同じ形）。/designsheets 自体の一覧は無く 404。

server {
    listen 80;
    listen [::]:80;
    server_name sandbox.yoshina.moe;

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sandbox.yoshina.moe;

    ssl_certificate     /etc/letsencrypt/live/sandbox.yoshina.moe/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sandbox.yoshina.moe/privkey.pem;

    root /var/www/sandbox.yoshina.moe;
    charset utf-8;

    # 受け取るものが無い。
    client_max_body_size 1k;

    # try_files で見つけたファイルはこの location のまま返る（内部リダイレクトしない）ので、
    # 下の .html → 拡張子なしのリダイレクトとループしない。
    location = / {
        try_files /index.html =404;
    }

    location = /index.html {
        return 301 /;
    }

    location ~ ^(/.+)\.html$ {
        return 301 $1$is_args$args;
    }

    # example: /no.N → examples/N/index.html、/no.N/x → examples/N/x（無ければ x.html）
    location ~ ^/no\.(\d+)$ {
        try_files /examples/$1/index.html =404;
    }

    location ~ ^/no\.(\d+)/(index)?$ {
        return 301 /no.$1$is_args$args;
    }

    location ~ ^/no\.(\d+)/(.+)$ {
        try_files /examples/$1/$2 /examples/$1/$2.html =404;
    }

    # 旧 URL（/examples/N.html → /examples/N は上の .html ルールが先に寄せる）と
    # 実ディレクトリへの直アクセスは /no.N へ寄せる。
    location ~ ^/examples/(\d+)(/.*)?$ {
        return 301 /no.$1$2$is_args$args;
    }

    # designsheet: /designsheets/N → designsheets/N/index.html、/designsheets/N/x → designsheets/N/x（無ければ x.html）。
    # /designsheets と /designsheets/ は下の location / に落ちて 404（一覧は置かない）。
    location ~ ^/designsheets/(\d+)$ {
        try_files /designsheets/$1/index.html =404;
    }

    location ~ ^/designsheets/(\d+)/(index)?$ {
        return 301 /designsheets/$1$is_args$args;
    }

    location ~ ^/designsheets/(\d+)/(.+)$ {
        try_files /designsheets/$1/$2 /designsheets/$1/$2.html =404;
    }

    location / {
        try_files $uri $uri.html =404;
    }

    location /assets/ {
        try_files $uri =404;
        expires 1h;
    }
}
